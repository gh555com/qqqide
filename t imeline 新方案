### 3. diff-window.js（核心逻辑）

```javascript
const { ipcRenderer } = require('electron');
const path = require('path');

// Monaco 加载（根据你的打包方式调整路径）
const loader = require('monaco-editor/esm/vs/loader');
// 或者用 AMD 方式：
// require.config({ paths: { vs: './node_modules/monaco-editor/min/vs' } });

let diffEditor = null;
let currentFile = null;
let timeline = []; // 当前文件的版本时间线

// ========== 初始化 ==========
window.addEventListener('DOMContentLoaded', () => {
  initMonaco();
  initWindowControls();
  initVersionSelectors();
});

// 接收主进程传来的初始信息
ipcRenderer.on('init-diff', (event, fileInfo) => {
  loadFile(fileInfo.filePath);
});

// ========== Monaco 初始化 ==========
function initMonaco() {
  require(['vs/editor/editor.main'], function () {
    diffEditor = monaco.editor.createDiffEditor(
      document.getElementById('diff-container'),
      {
        // 核心配置
        renderSideBySide: true,
        minimap: { enabled: true },
        readOnly: true,                    // diff 查看器，只读
        originalEditable: false,
        automaticLayout: true,             // 自动响应容器大小变化

        // 差异显示
        renderIndicators: true,
        ignoreTrimWhitespace: false,

        // 隐藏未变区域（折叠相同段落）
        hideUnchangedRegions: {
          enabled: true,
          revealLineCount: 3,             // 差异上下显示3行上下文
          minimumLineCount: 5,            // 至少5行相同才折叠
        },

        // 视觉
        fontSize: 13,
        lineNumbers: 'on',
        scrollBeyondLastLine: false,
        wordWrap: 'off',
        theme: 'vs-dark',
      }
    );

    // 监听差异变化，更新状态栏
    diffEditor.onDidUpdateDiff(() => {
      updateDiffStats();
    });
  });
}

// ========== 文件加载 ==========
async function loadFile(filePath) {
  currentFile = filePath;
  document.getElementById('current-file-path').textContent = filePath;

  // 获取时间线
  timeline = await ipcRenderer.invoke('get-file-timeline', filePath);

  // 填充版本下拉框
  populateVersionSelects(timeline);

  // 默认：左边选最早版本，右边选最新版本
  if (timeline.length >= 2) {
    document.getElementById('version-left').value = timeline[0].id;
    document.getElementById('version-right').value = timeline[timeline.length - 1].id;
    await updateDiff();
  }
}

// ========== 版本下拉框 ==========
function populateVersionSelects(versions) {
  const leftSelect = document.getElementById('version-left');
  const rightSelect = document.getElementById('version-right');

  const options = versions.map(v =>
    `<option value="${v.id}">${v.label} (${formatTime(v.timestamp)})</option>`
  ).join('');

  leftSelect.innerHTML = options;
  rightSelect.innerHTML = options;
}

function initVersionSelectors() {
  document.getElementById('version-left').addEventListener('change', updateDiff);
  document.getElementById('version-right').addEventListener('change', updateDiff);
}

// ========== 更新 Diff ==========
async function updateDiff() {
  const leftId = document.getElementById('version-left').value;
  const rightId = document.getElementById('version-right').value;

  if (!leftId || !rightId || !currentFile) return;

  // 并行获取两个版本的内容
  const [leftContent, rightContent] = await Promise.all([
    ipcRenderer.invoke('get-file-content', currentFile, leftId),
    ipcRenderer.invoke('get-file-content', currentFile, rightId),
  ]);

  // 确定语言（根据文件扩展名）
  const ext = path.extname(currentFile).slice(1);
  const language = getLanguageByExt(ext);

  // 设置 diff model
  diffEditor.setModel({
    original: monaco.editor.createModel(leftContent, language),
    modified: monaco.editor.createModel(rightContent, language),
  });
}

// ========== 差异统计 ==========
function updateDiffStats() {
  const changes = diffEditor.getLineChanges();
  if (!changes) return;

  let added = 0, removed = 0;
  changes.forEach(change => {
    added += (change.modifiedEndLineNumber - change.modifiedStartLineNumber + 1);
    removed += (change.originalEndLineNumber - change.originalStartLineNumber + 1);
    // 如果是纯修改（非新增/删除），两边都有行
    if (change.originalStartLineNumber === 0) removed = 0;
    if (change.modifiedStartLineNumber === 0) added = 0;
  });

  document.getElementById('stat-added').textContent = `+${added} 行`;
  document.getElementById('stat-removed').textContent = `-${removed} 行`;
  document.getElementById('stat-changes').textContent = `${changes.length} 处修改`;
}

// ========== 窗口控制 ==========
function initWindowControls() {
  const { remote } = require('electron');
  // Electron 20 用 remote 或 ipcRenderer

  document.getElementById('btn-close').addEventListener('click', () => {
    window.close();
  });
  document.getElementById('btn-minimize').addEventListener('click', () => {
    ipcRenderer.send('diff-window-minimize');
  });
  document.getElementById('btn-maximize').addEventListener('click', () => {
    ipcRenderer.send('diff-window-maximize');
  });
}

// ========== 工具函数 ==========
function formatTime(timestamp) {
  const d = new Date(timestamp);
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}

function getLanguageByExt(ext) {
  const map = {
    'js': 'javascript', 'ts': 'typescript', 'py': 'python',
    'go': 'go', 'rs': 'rust', 'java': 'java',
    'html': 'html', 'css': 'css', 'json': 'json',
    'md': 'markdown', 'yaml': 'yaml', 'yml': 'yaml',
    'sh': 'shell', 'bash': 'shell', 'sql': 'sql',
    'c': 'c', 'cpp': 'cpp', 'h': 'c',
  };
  return map[ext] || 'plaintext';
}
```

