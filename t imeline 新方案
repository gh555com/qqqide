### 1. 主进程：创建独立悬浮窗

```javascript
// main.js (Electron 主进程)
const { BrowserWindow, ipcMain } = require('electron');
const path = require('path');

function createDiffWindow(parentWindow, fileInfo) {
  const diffWin = new BrowserWindow({
    width: 1200,
    height: 700,
    minWidth: 600,
    minHeight: 400,
    frame: false,
    alwaysOnTop: false,
    parent: parentWindow,
    modal: false,
    resizable: true,
    webPreferences: {
      nodeIntegration: true,
      contextIsolation: false,
    }
  });

  diffWin.loadFile(path.join(__dirname, 'diff-window.html'));

  diffWin.webContents.on('did-finish-load', () => {
    diffWin.webContents.send('init-diff', fileInfo);
  });

  return diffWin;
}

// 接收渲染进程请求：获取文件的时间线版本列表
ipcMain.handle('get-file-timeline', async (event, filePath) => {
  // 从你的后端/版本系统获取该文件的所有历史版本
  // 返回格式：[{ id, timestamp, label, content }, ...]
  return await fetchFileTimeline(filePath);
});

// 接收请求：获取某版本的文件内容
ipcMain.handle('get-file-content', async (event, filePath, versionId) => {
  return await fetchFileContent(filePath, versionId);
});
```

